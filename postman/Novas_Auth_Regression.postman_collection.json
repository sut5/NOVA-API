{
  "info": {
    "name": "Novas Auth Regression Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "valid_phone",
      "value": "910972745"
    },
    {
      "key": "valid_password",
      "value": "password"
    },
    {
      "key": "invalid_phone",
      "value": "251900000001"
